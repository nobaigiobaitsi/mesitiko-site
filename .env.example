# The build generates static HTML at every clean URL.
# Origin only: do not add a repository subpath here.
VITE_SITE_URL=https://leafproperties.gr

# Cloudflare serves this site at the root of the domain.
# Set these values in Cloudflare build variables as well as your local .env.local.
VITE_BASE_PATH=/

# Public browser configuration only. Never put secret API keys in VITE_*.
# Contact: set the Web3Forms submit endpoint and access key together.
# Leave both blank to open an email draft instead.
VITE_CONTACT_ENDPOINT=
VITE_WEB3FORMS_ACCESS_KEY=

# Newsletter: Brevo form endpoint and public Turnstile site key are configured
# in src/data/newsletter.js. No newsletter API key or backend is needed.
