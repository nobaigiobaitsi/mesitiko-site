# The build generates static HTML at every clean URL.
# Origin only: do not add a repository subpath here.
VITE_SITE_URL=https://leafproperties.net

# Root domain: /. GitHub project site: /mesitiko-site/.
# The included GitHub Actions workflow sets both values automatically.
VITE_BASE_PATH=/

# Optional JSON POST endpoints. Blank = open an email draft.
# Public browser configuration only. Never put secret API keys in VITE_*.
VITE_CONTACT_ENDPOINT=
VITE_NEWSLETTER_ENDPOINT=
