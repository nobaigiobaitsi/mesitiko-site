# Hash routing works on GitHub Pages without server rewrites.
VITE_ROUTER_MODE=hash

# For history routing on a subdirectory, also set this (e.g. /my-repo/).
VITE_BASE_PATH=./

# Optional JSON POST endpoints. Blank = open an email draft.
# Public browser configuration only. Never put secret API keys in VITE_*.
VITE_CONTACT_ENDPOINT=
VITE_NEWSLETTER_ENDPOINT=
